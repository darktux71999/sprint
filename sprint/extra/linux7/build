#!/bin/sh -e

# Copy our custom config
cp files/config .config

# Ensure dependencies are resolved
make olddefconfig

# Build kernel, modules, and device tree
make -j"$(nproc)" bzImage
make -j"$(nproc)" modules

# Install
make INSTALL_MOD_PATH="$1" modules_install
cp arch/x86/boot/bzImage "$1/boot/vmlinuz-7.0.2-custom"
cp .config "$1/boot/config-7.0.2-custom"
cp System.map "$1/boot/System.map-7.0.2-custom"

# Clean up source
rm -rf "$1/usr/src"
