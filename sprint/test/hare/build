#!/bin/sh -e

# Reescribe la regla rt.o para clang (no acepta multi-input con -o)
awk '
/^\t@\$\(AS\) \$\(ASFLAGS\) -o \$@ \$\(rt_s\)$/ {
    print "\t@tmp=$$(mktemp -d); objs=\"\"; for f in $(rt_s); do obj=\"$$tmp/$$(basename $$f .s).o\"; $(AS) $(ASFLAGS) -o \"$$obj\" \"$$f\" || { rm -rf \"$$tmp\"; exit 1; }; objs=\"$$objs $$obj\"; done; ld.lld -r -o $@ $$objs; rm -rf \"$$tmp\""
    next
}
{ print }
' makefiles/linux.x86_64.mk > makefiles/linux.x86_64.mk.tmp
mv makefiles/linux.x86_64.mk.tmp makefiles/linux.x86_64.mk

make
make DESTDIR="$1" install
