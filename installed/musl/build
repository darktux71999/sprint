#!/bin/sh -e


# ---------------------------------------------------------
# FASE 1: Preparar Mimalloc (el "injerto")
# ---------------------------------------------------------
echo ">>> Preparando Mimalloc 2.2.7..."
# Copiamos el wrapper mimalloc.c dentro del árbol de mimalloc
# El directorio mimalloc/ ya existe (git clone) y los archivos
# mimalloc.c, mimalloc-verify-syms.sh ya están en el CWD
cp -f mimalloc.c mimalloc/src/mimalloc.c

# ---------------------------------------------------------
# FASE 2: Aplicar Parches
# ---------------------------------------------------------
echo ">>> Aplicando parches..."
for patch in *.patch; do
    echo "   aplicando: $patch"
    patch -p1 < "$patch"
done

# ---------------------------------------------------------
# FASE 3: Eliminar ASM lento (Clang genera mejor código)
# ---------------------------------------------------------
echo ">>> Eliminando ASM memcpy/memmove (usaremos la versión C)..."
rm -f src/string/x86_64/memcpy.s src/string/x86_64/memmove.s

# ---------------------------------------------------------
# FASE 4: Configurar Musl con allocador externo
# ---------------------------------------------------------
echo ">>> Configurando musl..."
./configure \
    --prefix=/usr \
    --syslibdir=/usr/lib \
    --disable-gcc-wrapper \
    --with-malloc=external

# ---------------------------------------------------------
# FASE 5: Compilar Musl enlazando con mimalloc
# ---------------------------------------------------------
# EXTRA_OBJ: el Makefile (vía parche plumb) compila
# mimalloc/src/mimalloc.c usando $(srcdir)/mimalloc/ y
# verifica símbolos automáticamente
echo ">>> Compilando musl + mimalloc..."
make EXTRA_OBJ=./src/malloc/external/mimalloc.o

# ---------------------------------------------------------
# FASE 6: Instalar
# ---------------------------------------------------------
echo ">>> Instalando..."
make DESTDIR="$1" install

# ---------------------------------------------------------
# FASE 7: Enlaces y Compatibilidad (estilo KISS)
# ---------------------------------------------------------
echo ">>> Configurando enlaces simbólicos..."
mkdir -p "$1/usr/bin"

# ldd -> ld-musl
ln -s /usr/lib/ld-musl-x86_64.so.1 "$1/usr/bin/ldd"

# Arreglar enlace libc.so -> ld-musl
ln -sf libc.so "$1/usr/lib/ld-musl-x86_64.so.1"

# ---------------------------------------------------------
# FASE 8: Cabeceras BSD
# ---------------------------------------------------------
echo ">>> Instalando cabeceras BSD..."
mkdir -p "$1/usr/include/sys"
cp -f cdefs.h queue.h tree.h "$1/usr/include/sys/"

# ---------------------------------------------------------
# FASE 9: Utilidades Extra (Chimera Style)
# ---------------------------------------------------------
echo ">>> Compilando utilidades extra..."

# Stack Protector (libssp_nonshared.a) - Vital para Clang Hardened
clang $CFLAGS -c __stack_chk_fail_local.c -o __stack_chk_fail_local.o
llvm-ar rcs "$1/usr/lib/libssp_nonshared.a" __stack_chk_fail_local.o

# Compilar getconf, getent, iconv
for tool in getconf getent iconv; do
    echo "   compilando $tool..."
    cc $CFLAGS "$tool.c" -o "$1/usr/bin/$tool"
done

echo ">>> ¡Build de musl 1.2.6 + mimalloc 2.2.7 completado!"
