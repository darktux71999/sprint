#!/bin/sh -e

export DESTDIR="$1"

pkg-config --exists libva || va_enabled=false

meson setup \
    -Dprefix=/usr \
    -Dsysconfdir=/etc \
    -Dmandir=/usr/share/man \
    -Dlocalstatedir=/var \
    -Dbuildtype=release \
    -Dglx-read-only-text=true \
    -Dplatforms=x11 \
    -Dglx=auto \
    -Degl=enabled \
    -Dgallium-drivers=nouveau \
    -Dvalgrind=false \
    -Dzstd=disabled \
    -Dgallium-va="${va_enabled:-true}" \
    -Dglvnd=false  \
    -Dvideo-codecs=vc1dec,h264dec,h264enc,h265dec,h265enc \
    -Dvulkan-drivers=nouveau \
    output

ninja -C output
ninja -C output install
