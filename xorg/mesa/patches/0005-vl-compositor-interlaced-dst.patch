--- a/src/gallium/auxiliary/vl/vl_compositor.c
+++ b/src/gallium/auxiliary/vl/vl_compositor.c
@@ -727,6 +727,63 @@
 
    dst_surfaces = dst->get_surfaces(dst);
 
+   if (dst->interlaced) {
+      const unsigned nr_planes = util_format_get_num_planes(dst->buffer_format);
+      bool clear = util_format_get_nr_components(src->buffer_format) == 1;
+      union pipe_color_union clear_color = { .f = {0.5, 0.5} };
+      unsigned plane, field;
+
+      /* Interlaced buffers keep each field of each plane in its own surface
+       * layer (surfaces[plane * 2 + field]). Render every field separately,
+       * selecting the matching source field and halving the destination area
+       * so the draw stays inside the field surface bounds. */
+      for (plane = 0; plane < nr_planes; ++plane) {
+         enum vl_compositor_plane yuv_plane =
+            plane == 0 ? VL_COMPOSITOR_PLANE_Y :
+            nr_planes == 2 ? VL_COMPOSITOR_PLANE_UV :
+            plane == 1 ? VL_COMPOSITOR_PLANE_U : VL_COMPOSITOR_PLANE_V;
+         struct u_rect plane_rect;
+
+         plane_rect.x0 = util_format_get_plane_width(dst->buffer_format, plane, dst_rect->x0);
+         plane_rect.x1 = util_format_get_plane_width(dst->buffer_format, plane, dst_rect->x1);
+         plane_rect.y0 = util_format_get_plane_height(dst->buffer_format, plane, dst_rect->y0) / 2;
+         plane_rect.y1 = util_format_get_plane_height(dst->buffer_format, plane, dst_rect->y1) / 2;
+
+         for (field = 0; field < 2; ++field) {
+            struct pipe_surface *dst_surface = &dst_surfaces[plane * 2 + field];
+
+            if (!dst_surface->texture)
+               continue;
+
+            if (clear && plane) {
+               s->used_layers = 0;
+               vl_compositor_set_clear_color(s, &clear_color);
+               vl_compositor_render(s, c, dst_surface, &plane_rect, true);
+            } else {
+               struct vl_compositor_layer *layer = &s->layers[0];
+               float half_a_line;
+
+               set_yuv_layer(s, c, 0, src, src_rect, NULL, yuv_plane,
+                             field ? VL_COMPOSITOR_BOB_BOTTOM : VL_COMPOSITOR_BOB_TOP);
+               /* BOB shifts the source by half a frame line, but with fields
+                * stored as array layers the texel centers are already the
+                * field lines, so undo the shift to avoid blending rows. */
+               half_a_line = 0.5f / layer->zw.y;
+               if (field) {
+                  layer->src.tl.y += half_a_line;
+                  layer->src.br.y += half_a_line;
+               } else {
+                  layer->src.tl.y -= half_a_line;
+                  layer->src.br.y -= half_a_line;
+               }
+               vl_compositor_set_layer_dst_area(s, 0, &plane_rect);
+               vl_compositor_render(s, c, dst_surface, NULL, false);
+            }
+         }
+      }
+      return;
+   }
+
    set_yuv_layer(s, c, 0, src, src_rect, NULL, VL_COMPOSITOR_PLANE_Y, deinterlace);
    vl_compositor_set_layer_dst_area(s, 0, dst_rect);
    vl_compositor_render(s, c, &dst_surfaces[0], NULL, false);
