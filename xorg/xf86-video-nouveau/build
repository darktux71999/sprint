#!/bin/sh -e

export DESTDIR="$1"

export LDFLAGS="$LDFLAGS -Wl,-z,lazy"
export CFLAGS="$CFLAGS -fcommon"

# Apply patches
for patch in *.patch *.diff; do
    [ -f "$patch" ] || continue
    patch -p1 < "$patch"
done

NOCONFIGURE=1 ./autogen.sh
./configure \
    --prefix=/usr

make
make install

install -Dm644 20-gpu.conf "$1/etc/X11/xorg.conf.d/20-gpu.conf"
