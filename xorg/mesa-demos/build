#!/bin/sh -e

export DESTDIR="$1"

patch -p1 < no-glu-required.patch

export CFLAGS="$CFLAGS -DGLU_NOT_REQUIRED"

meson setup \
    -Dprefix=/usr \
    -Dsysconfdir=/etc \
    -Dmandir=/usr/share/man \
    -Dlocalstatedir=/var \
    -Dbuildtype=release \
    -Degl=disabled \
    -Dgles1=disabled \
    -Dgles2=disabled \
    -Dglut=disabled \
    -Dosmesa=disabled \
    -Dvulkan=disabled \
    -Dwayland=disabled \
    -Dwith-system-data-files=true \
    output

ninja -C output
ninja -C output install
