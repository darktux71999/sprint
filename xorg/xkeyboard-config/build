#!/bin/sh -e

export DESTDIR="$1"

# Swap to shell script instead of perl script
# for conversion of rules files. See files/xml2lst.
sed 's/xml2lst\.pl/xml2lst/' rules/meson.build > _
mv -f _ rules/meson.build

# Remove po/ dir, and usless i18n module.
sed -e "/subdir('po')/d" -e "/i18n/d" meson.build > _
mv -f _ meson.build

meson setup \
    -Dprefix=/usr \
    -Dcompat-rules=true \
    -Dxorg-rules-symlinks=true \
    output

ninja -C output
ninja -C output install

# KISS cannot migrate the existing /usr/share/X11/xkb directory to a
# symlink during an upgrade. Keep XKB rules at the legacy X11 path and
# provide the versioned path as a symlink instead.
rm -f "$DESTDIR/usr/share/X11/xkb"
mv "$DESTDIR/usr/share/xkeyboard-config-2" "$DESTDIR/usr/share/X11/xkb"
ln -s X11/xkb "$DESTDIR/usr/share/xkeyboard-config-2"
