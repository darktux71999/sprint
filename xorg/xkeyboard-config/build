#!/bin/sh -e

export DESTDIR="$1"

# Swap to shell script instead of perl script
# for conversion of rules files. See files/xml2lst.
sed 's/xml2lst\.pl/xml2lst/' rules/meson.build > _
mv -f _ rules/meson.build

# Remove po/ dir, and usless i18n module.
sed -e "/subdir('po')/d" -e "/i18n/d" meson.build > _
mv -f _ meson.build

meson setup \
    -Dprefix=/usr \
    -Dcompat-rules=true \
    -Dxorg-rules-symlinks=true \
    output

ninja -C output
ninja -C output install

# KISS does not replace an existing directory with the legacy symlink during
# an upgrade.  Keep the canonical database for libxkbcommon and install a
# real legacy copy for Xorg, so both paths work without udev/systemd tooling.
rm -f "$DESTDIR/usr/share/X11/xkb"
mkdir -p "$DESTDIR/usr/share/X11/xkb"
cp -R "$DESTDIR/usr/share/xkeyboard-config-2/." \
    "$DESTDIR/usr/share/X11/xkb"
