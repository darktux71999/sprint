#!/bin/sh -e

export DESTDIR="$1"

# Build only the openmp component from llvm-project
cd openmp

cmake -B build -G Ninja -Wno-dev \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLIBOMP_ENABLE_SHARED=ON \
    -DLIBOMP_INSTALL_ALIASES=ON

cmake --build build
cmake --install build

# Create symlinks
ln -sf "libomp.so.$(cat ../llvm-known-version 2>/dev/null || echo 1)" "$1/usr/lib/libomp.so" 2>/dev/null || true
