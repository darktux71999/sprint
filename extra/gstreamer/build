#!/bin/sh -e

export DESTDIR="$1"

meson setup \
    -Dprefix=/usr \
    -Dlibexecdir=/usr/lib \
    -Dbuildtype=release \
    -Ddbghelp=disabled \
    -Dlibunwind=disabled \
    -Dlibdw=disabled \
    -Dintrospection=enabled \
    -Dtools=enabled \
    -Dcheck=enabled \
    -Dnls=enabled \
    -Dbash-completion=disabled \
    -Dexamples=disabled \
    -Dtests=disabled \
    -Dbenchmarks=disabled \
    -Ddoc=disabled \
    -Dptp-helper-permissions=capabilities \
    output

ninja -C output
ninja -C output install
