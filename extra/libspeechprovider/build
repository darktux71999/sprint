#!/bin/sh -e

meson setup build \
	--prefix=/usr \
	--libexecdir=/usr/lib \
	-Dbuildtype=release \
	-Ddocs=false \
	-Dtests=false
samu -C build
DESTDIR="$1" samu -C build install
for license in LICENSE COPYING; do
	if [ -f "$license" ]; then
		install -Dm644 "$license" "$1/usr/share/licenses/libspeechprovider/$license"
		break
	fi
done
