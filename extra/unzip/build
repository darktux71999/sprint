#!/bin/sh -e

# Adapted from Chimera Linux cports

CFLAGS="$CFLAGS -DWILD_STOP_AT_DIR -DLARGE_FILE_SUPPORT -DUNICODE_SUPPORT -DUNICODE_WCHAR -DUTF8_MAYBE_NATIVE -DNO_LCHMOD -DDATE_FORMAT=DF_YMD -DUSE_BZIP2 -DNATIVE"

make -f unix/Makefile \
    prefix=/usr \
    LF2= \
    D_USE_BZ2=-DUSE_BZIP2 \
    L_BZ2=-lbz2 \
    LOCAL_UNZIP="$CFLAGS" \
    CC="$CC" \
    CFLAGS="$CFLAGS" \
    LFLAGS1="$CFLAGS $LDFLAGS" \
    unzips

mkdir -p "$1/usr/bin" "$1/usr/share/man/man1"
make -f unix/Makefile install \
    prefix="$1/usr" \
    INSTALL_PROGRAM=install

# Create zipinfo symlink
ln -sf unzip "$1/usr/bin/zipinfo"
