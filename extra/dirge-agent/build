#!/bin/sh -e

export CARGO_HOME="$PWD"
export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$PWD=."

mkdir -p .cargo
cat > .cargo/config.toml <<EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"
EOF

# janetrs/evil-janet currently fails to generate usable bindings with the
# system LLVM 22. Keep the upstream feature set except for the Janet plugin.
cargo build --release --frozen --locked --no-default-features --features no-plugin

mkdir -p "$1/usr/bin"
cp -f target/release/dirge "$1/usr/bin/dirge"
