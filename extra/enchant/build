#!/bin/sh -e

export DESTDIR="$1"

# Replace groff doc generation with touch (groff not available in this system)
sed -i 's|groff -mandoc -Thtml $< > $@|touch $@|g' lib/Makefile.am
sed -i 's|groff -mandoc -Thtml $< > $@|touch $@|g' src/Makefile.am

./configure \
    --prefix=/usr \
    --enable-relocatable \
    --disable-static

make
make DESTDIR="$1" install
