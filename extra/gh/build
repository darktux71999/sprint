#!/bin/sh -e
# gh: GitHub CLI en Go. Usa modulos (necesita red en el build).
# -buildvcs=false: el tarball no trae .git y go1.27 aborta el stamp VCS.

go build -trimpath -buildvcs=false \
    -ldflags "-X github.com/cli/cli/v2/internal/build.Version=$2" \
    -o gh ./cmd/gh

mkdir -p "$1/usr/bin"
install -Dm755 gh "$1/usr/bin/gh"
