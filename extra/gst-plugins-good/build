#!/bin/sh -e
export DESTDIR="$1"

meson setup \
    -Dprefix=/usr \
    -Ddefault_library=shared \
    -Ddoc=disabled \
    -Dexamples=disabled \
    -Daalib=disabled \
    -Damrnb=disabled \
    -Damrwbdec=disabled \
    -Ddirectsound=disabled \
    -Ddv1394=disabled \
    -Ddv=disabled \
    -Dflac=disabled \
    -Djack=disabled \
    -Dlibcaca=disabled \
    -Dmpg123=disabled \
    -Doss4=disabled \
    -Doss=disabled \
    -Dosxaudio=disabled \
    -Dosxvideo=disabled \
    -Dpulse=disabled \
    -Dqt5=disabled \
    -Dqt6=disabled \
    -Drpicamsrc=disabled \
    -Dshout2=disabled \
    -Dspeex=disabled \
    -Dtaglib=disabled \
    -Dtwolame=disabled \
    -Dv4l2-libv4l2=disabled \
    -Dv4l2=disabled \
    -Dwaveform=disabled \
    -Dwavpack=disabled \
    -Dximagesrc=disabled \
    output

samu -C output
samu -C output install
