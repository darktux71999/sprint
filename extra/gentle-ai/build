#!/bin/sh -e

export DESTDIR="$1"

# Go puro (modernc.org/sqlite), sin cgo. Necesita red para bajar modulos.
# -buildvcs=false: el tarball no trae .git y go aborta el stamp VCS.
CGO_ENABLED=0 \
go build -trimpath -buildvcs=false \
    -ldflags "-s -w -X main.version=v$2" \
    -o gentle-ai ./cmd/gentle-ai

install -Dm755 gentle-ai "$1/usr/lib/gentle-ai/gentle-ai"

# gentle-ai aborta con "unsupported linux distro: no package manager found on
# PATH" si no ve brew/apt/dnf/pacman/apk/... y sprint no tiene ninguno. Un stub
# de pacman que sale con 1 le basta para reportar el distro como soportado y
# seguir; es lo mismo que hacia la instalacion manual.
install -Dm755 /dev/stdin "$1/usr/lib/gentle-ai/stub/pacman" <<'EOF'
#!/bin/sh
exit 1
EOF

# El stub se antepone solo si no hay un pacman real, para no taparlo.
install -Dm755 /dev/stdin "$1/usr/bin/gentle-ai" <<'EOF'
#!/bin/sh
if ! command -v pacman >/dev/null 2>&1; then
    PATH="/usr/lib/gentle-ai/stub${PATH:+:$PATH}"
    export PATH
fi
exec /usr/lib/gentle-ai/gentle-ai "$@"
EOF
