MC_RUNTIME="${MC_RUNTIME:-/usr/lib/mc-runtime}"
export MC_RUNTIME

if [ -d "$MC_RUNTIME/shim" ] && [ -d "$MC_RUNTIME/jre21" ]; then
	LD_PRELOAD="$MC_RUNTIME/shim/libc-compat.so${LD_PRELOAD:+:$LD_PRELOAD}"
	LD_LIBRARY_PATH="$MC_RUNTIME/shim:$MC_RUNTIME/jre21/lib:$MC_RUNTIME/jre21/lib/server${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
	export LD_PRELOAD LD_LIBRARY_PATH
fi
