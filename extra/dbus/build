#!/bin/sh -e

export DESTDIR="$1"

meson setup \
    -Dprefix=/usr \
    -Dsysconfdir=/etc \
    -Dasserts=false \
    -Ddbus_user=root \
    -Ddoxygen_docs=disabled \
    -Depoll=enabled \
    -Dinotify=enabled \
    -Dlibaudit=disabled \
    -Dselinux=disabled \
    -Dsystemd=disabled \
    -Duser_session=true \
    -Dx11_autolaunch=disabled \
    -Dxml_docs=disabled \
    build

ninja -C build
ninja -C build install

rm -rf "$1/run"
