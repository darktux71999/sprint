#!/bin/sh -e

for patch in *.patch; do
	patch -p1 < "$patch"
done

cd src

make CC=cc linux PLAT=linux LUAV=5.1 \
	LUAPREFIX_linux=/usr \
	LUAINC_linux=/usr/include/luajit-2.1

make CC=cc install-unix PLAT=linux LUAV=5.1 \
	LUAPREFIX_linux=/usr \
	LUAINC_linux=/usr/include/luajit-2.1 \
	DESTDIR="$1"

install -Dm644 ../LICENSE "$1/usr/share/licenses/luasocket/LICENSE"
