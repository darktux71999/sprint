#!/bin/sh -e

JAVA_HOME="usr/lib/jvm/java-21-openjdk"
dest="$1/$JAVA_HOME"
mkdir -p "$dest"

# KISS strips the top-level directory from the tarball
find . -mindepth 1 -maxdepth 1 -exec cp -a {} "$dest/" \;

# Symlinks in /usr/bin
mkdir -p "$1/usr/bin"
for f in "$dest/bin/"*; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    ln -sf "../lib/jvm/java-21-openjdk/bin/$name" "$1/usr/bin/$name"
done

# Man pages
if [ -d "$dest/man/man1" ]; then
    mkdir -p "$1/usr/share/man/man1"
    for f in "$dest/man/man1/"*; do
        [ -f "$f" ] || continue
        name="${f##*/}"
        ln -sf "../../../../lib/jvm/java-21-openjdk/man/man1/$name" \
            "$1/usr/share/man/man1/$name"
    done
fi

# Default JVM symlink
mkdir -p "$1/usr/lib/jvm"
ln -sf "java-21-openjdk" "$1/usr/lib/jvm/default"

# Cacerts -> system store
rm -f "$dest/lib/security/cacerts"
ln -sf "../../../../../../etc/ssl/certs/java/cacerts" \
    "$dest/lib/security/cacerts"
