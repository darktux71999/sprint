#!/bin/sh -e

export DESTDIR="$1"

# Bootstrap muon with just cc (no meson needed)
./bootstrap.sh build

# Configure minimal build pointing to /usr
build/muon-bootstrap setup \
    -Dprefix=/usr \
    -Dlibcurl=disabled \
    -Dlibarchive=disabled \
    -Dlibpkgconf=enabled \
    -Dsamurai=disabled \
    -Dtracy=disabled \
    -Dman-pages=disabled \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    build

build/muon-bootstrap -C build samu
build/muon -C build install
