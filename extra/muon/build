#!/bin/sh -e

export DESTDIR="$1"

# Bootstrap muon with just cc (no meson needed)
CFLAGS=-DBOOTSTRAP_NO_SAMU ./bootstrap.sh build-boot

# Use bootstrap to configure minimal build
build-boot/muon-bootstrap setup \
    -Dauto_features=disabled \
    -Dwrap_mode=nodownload \
    -Dlibcurl=disabled \
    -Dlibarchive=disabled \
    -Dlibpkgconf=enabled \
    -Dsamurai=disabled \
    -Dtracy=disabled \
    -Dman-pages=disabled \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    build-boot

samu -C build-boot

# Use muon to do full build
PATH="$PATH:$PWD/build-boot" \
build-boot/muon setup \
    -Dlibcurl=disabled \
    -Dlibarchive=disabled \
    -Dlibpkgconf=enabled \
    -Dsamurai=disabled \
    -Dtracy=disabled \
    -Dman-pages=disabled \
    -Dmeson-docs=disabled \
    -Dmeson-tests=disabled \
    -Dwebsite=disabled \
    build .

cd build
samu
samu install
