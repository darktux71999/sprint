#!/bin/sh -e

export DESTDIR="$1"

meson setup \
    -Dprefix=/usr \
    -Ddefault_library=shared \
    -Dcrypto-library=openssl \
    -Dgtk_doc=disabled \
    -Dexamples=disabled \
    -Dintrospection=disabled \
    -Dtests=disabled \
    -Dgupnp=disabled \
    output

ninja -C output
ninja -C output install
