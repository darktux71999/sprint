#!/bin/sh -e

./configure \
    --prefix=/usr \
    --enable-elf-shlibs \
    --enable-e2initrd-helper \
    --enable-symlink-build \
    --enable-symlink-install \
    --enable-relative-symlinks \
    --disable-rpath \
    --disable-fsck \
    --disable-uuidd \
    --disable-libuuid \
    --disable-libblkid \
    --disable-fuse2fs \
    --with-root-prefix=/usr \
    e2fsprogs_cv_struct_st_flags=no \
    MKDIR_P="mkdir -p"

make
make DESTDIR="$1" install install-libs

# Remove fsck wrapper (we don't need it)
rm -f "$1/usr/sbin/fsck"
rmdir "$1/usr/sbin" 2>/dev/null || true
