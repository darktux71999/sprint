#!/bin/sh -e

export DESTDIR="$1"

# Silence noisy warnings
export CFLAGS="$CFLAGS -w"
export CXXFLAGS="$CXXFLAGS -w"

meson setup \
    -Dprefix=/usr \
    -Ddefault_library=shared \
    -Dauto_features=disabled \
    -Dtests=disabled \
    -Dexamples=disabled \
    -Ddoc=disabled \
    -Dglib_assert=false \
    -Dglib_checks=false \
    -Dglib_debug=disabled \
    -Dwayland=disabled \
    -Dintrospection=disabled \
    output

ninja -C output
ninja -C output install
