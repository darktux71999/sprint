#!/bin/sh -e

meson setup build \
	--prefix=/usr \
	--libexecdir=/usr/lib \
	-Dbuildtype=release \
	-Ddoc=disabled \
	-Dexamples=disabled \
	-Dglib_assert=false \
	-Dglib_checks=false \
	-Dtests=disabled
ninja -C build
DESTDIR="$1" ninja -C build install
rm -rf "$1/usr/share/doc"
install -Dm644 COPYING "$1/usr/share/licenses/gst-plugins-bad/COPYING"
