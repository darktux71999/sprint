+// SearXNGResult es la fila mínima que DeepTutor lee: title, url, content, engine.
+// Se mantiene snippet duplicado para no romper clientes viejos de SearxGo.
+type SearXNGResult struct {
+	Title   string `json:"title"`
+	URL     string `json:"url"`
+	Content string `json:"content"`
+	Snippet string `json:"snippet"`
+	Engine  string `json:"engine"`
+}
+
+// SearXNGResponse envuelve resultados como SearXNG: objeto con lista, nunca null.
+type SearXNGResponse struct {
+	Query          string        `json:"query"`
+	NumberOfResults int          `json:"number_of_results"`
+	Results        []SearXNGResult `json:"results"`
+}
+
+// WriteSearXNGResponse escribe compat SearXNG para ?format=json (DeepTutor).
+// No toca el JSON por defecto ni ?format=html ni ?timings=1 del frontend.
+func (rh *ResponseHelper) WriteSearXNGResponse(w http.ResponseWriter, query string, results []en.Result) error {
+	out := make([]SearXNGResult, 0, len(results))
+	for _, r := range results {
+		out = append(out, SearXNGResult{
+			Title:   r.Title,
+			URL:     r.URL,
+			Content: r.Snippet,
+			Snippet: r.Snippet,
+			Engine:  r.Engine,
+		})
+	}
+	return rh.WriteJSON(w, SearXNGResponse{
+		Query:           query,
+		NumberOfResults: len(out),
+		Results:         out,
+	})
+}
