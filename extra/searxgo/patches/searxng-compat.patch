+++ b/internal/server/searxng_compat_test.go
@@ -0,0 +1,82 @@
+package server
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	en "searxgo/internal/engine"
+)
+
+type stubSearxngEngine struct {
+	items []en.Result
+}
+
+func (s *stubSearxngEngine) Name() string { return "stub" }
+func (s *stubSearxngEngine) Search(ctx context.Context, q string, page, size int) ([]en.Result, error) {
+	return s.items, nil
+}
+
+// RED: DeepTutor searxng provider hace GET /search?q=..&format=json y exige
+// objeto {"results":[{title,url,content,engine}]}. SearxGo hoy ignora format=json
+// y devuelve array [{title,url,snippet,engine}].
+func TestSearchFormatJsonSearXNGCompat(t *testing.T) {
+	srv := NewServer([]en.SearchEngine{&stubSearxngEngine{items: []en.Result{
+		{Title: "T", URL: "https://example.com/x", Snippet: "sumario", Engine: "stub"},
+	}}})
+	srv.StaticDir = "../../static"
+
+	req := httptest.NewRequest(http.MethodGet, "/search?q=linux&format=json&size=5", nil)
+	rec := httptest.NewRecorder()
+	srv.Handler().ServeHTTP(rec, req)
+
+	if ct := rec.Result().Header.Get("Content-Type"); ct != "application/json" {
+		t.Fatalf("Content-Type = %q, quiero application/json", ct)
+	}
+	var payload map[string]any
+	if err := json.Unmarshal(rec.Body.Bytes(), &payload); err != nil {
+		t.Fatalf("no es objeto JSON (sigue siendo array?): %v body=%.200q", err, rec.Body.String())
+	}
+	raw, ok := payload["results"]
+	if !ok {
+		t.Fatalf("falta clave results para compat SearXNG, body=%.500q", rec.Body.String())
+	}
+	rows, ok := raw.([]any)
+	if !ok {
+		t.Fatalf("results no es lista, body=%.500q", rec.Body.String())
+	}
+	if len(rows) == 0 {
+		t.Fatalf("results vacía, quiero 1 fila del stub")
+	}
+	row := rows[0].(map[string]any)
+	if row["title"] != "T" || row["url"] != "https://example.com/x" {
+		t.Fatalf("title/url no mapeados: %+v", row)
+	}
+	if row["content"] != "sumario" {
+		t.Fatalf("content = %q, quiero snippet mapeado a content para DeepTutor", row["content"])
+	}
+	if row["engine"] != "stub" {
+		t.Fatalf("engine = %q, quiero stub", row["engine"])
+	}
+}
+
+// El caso vacío debe devolver [] y no null, DeepTutor exige lista.
+func TestSearchFormatJsonEmptyIsList(t *testing.T) {
+	srv := NewServer(nil)
+	srv.StaticDir = "../../static"
+
+	req := httptest.NewRequest(http.MethodGet, "/search?q=kiss&format=json&size=0", nil)
+	rec := httptest.NewRecorder()
+	srv.Handler().ServeHTTP(rec, req)
+
+	body := strings.TrimSpace(rec.Body.String())
+	if !strings.Contains(body, `"results"`) {
+		t.Fatalf("sin clave results: %.500q", body)
+	}
+	if strings.Contains(body, `"results":null`) {
+		t.Fatalf("results es null, quiero []: %.500q", body)
+	}
+}
