diff --git a/internal/engines/codeberg.go b/internal/engines/codeberg.go
new file mode 100644
index 0000000..0c6d365
--- /dev/null
+++ b/internal/engines/codeberg.go
@@ -0,0 +1,78 @@
+package engines
+
+import (
+    "context"
+    "encoding/json"
+    "fmt"
+    "net/url"
+    "strconv"
+    "strings"
+
+    en "searxgo/internal/engine"
+    "searxgo/internal/httpx"
+)
+
+type codeberg struct{}
+
+func NewCodeberg() en.SearchEngine { return &codeberg{} }
+
+func (c *codeberg) Name() string { return "codeberg" }
+
+// Search queries Codeberg's public Forgejo API for repositories
+// (name, description and topics). Code search is not exposed by the
+// public API. Anonymous use is rate limited by the instance.
+func (c *codeberg) Search(ctx context.Context, q string, page int, size int) ([]en.Result, error) {
+    if strings.TrimSpace(q) == "" { return nil, nil }
+    if size <= 0 { size = 10 }
+    // Codeberg's repo search is slow on big instances (TTFB often >4s);
+    // 10 results is plenty for aggregation and keeps the query cheaper.
+    if size > 10 { size = 10 }
+
+    searchURL := "https://codeberg.org/api/v1/repos/search?q=" + url.QueryEscape(q) +
+        "&limit=" + strconv.Itoa(size)
+
+    headers := map[string]string{
+        "Accept":     "application/json",
+        "User-Agent": "SearxGO/1.0",
+    }
+
+    body, status, err := httpx.GetWithHeaders(ctx, searchURL, headers)
+    if err != nil { return nil, err }
+    if status < 200 || status >= 300 { return nil, fmt.Errorf("codeberg: http %d", status) }
+
+    type repoOwner struct {
+        Login     string `json:"login"`
+        AvatarURL string `json:"avatar_url"`
+    }
+    type repoItem struct {
+        Name        string    `json:"name"`
+        FullName    string    `json:"full_name"`
+        Description string    `json:"description"`
+        HTMLURL     string    `json:"html_url"`
+        Owner       repoOwner `json:"owner"`
+    }
+    var payload struct {
+        OK   bool       `json:"ok"`
+        Data []repoItem `json:"data"`
+    }
+    if err := json.Unmarshal(body, &payload); err != nil { return nil, err }
+
+    results := make([]en.Result, 0, size)
+    for _, r := range payload.Data {
+        name := r.FullName
+        if name == "" { name = r.Owner.Login + "/" + r.Name }
+        snippet := strings.TrimSpace(r.Description)
+        if len(snippet) > 300 { snippet = snippet[:300] + "..." }
+        favicon := r.Owner.AvatarURL
+        if favicon == "" { favicon = "https://codeberg.org/favicon.ico" }
+        results = append(results, en.Result{
+            Title:   name,
+            URL:     r.HTMLURL,
+            Snippet: snippet,
+            Engine:  c.Name(),
+            Favicon: favicon,
+        })
+        if len(results) >= size { break }
+    }
+    return results, nil
+}
diff --git a/internal/engines/github.go b/internal/engines/github.go
new file mode 100644
index 0000000..bcc97ed
--- /dev/null
+++ b/internal/engines/github.go
@@ -0,0 +1,108 @@
+package engines
+
+import (
+    "context"
+    "encoding/json"
+    "fmt"
+    "net/url"
+    "strconv"
+    "strings"
+
+    en "searxgo/internal/engine"
+    "searxgo/internal/httpx"
+)
+
+type github struct{}
+
+func NewGithub() en.SearchEngine { return &github{} }
+
+func (g *github) Name() string { return "github" }
+
+// Search queries GitHub's public search API for repositories and issues.
+// Code search requires authentication and is intentionally out of scope.
+// Unauthenticated search is rate limited to 10 requests/minute.
+func (g *github) Search(ctx context.Context, q string, page int, size int) ([]en.Result, error) {
+    if strings.TrimSpace(q) == "" { return nil, nil }
+    if size <= 0 { size = 10 }
+
+    headers := map[string]string{
+        "Accept":     "application/vnd.github+json",
+        "User-Agent": "SearxGO/1.0",
+    }
+
+    results := make([]en.Result, 0, size)
+    var firstErr error
+
+    // Repositories
+    reposURL := "https://api.github.com/search/repositories?q=" + url.QueryEscape(q) +
+        "&per_page=" + strconv.Itoa(size)
+    if body, status, err := httpx.GetWithHeaders(ctx, reposURL, headers); err != nil {
+        firstErr = err
+    } else if status < 200 || status >= 300 {
+        firstErr = fmt.Errorf("github: http %d", status)
+    } else {
+        var payload struct {
+            Items []struct {
+                FullName    string `json:"full_name"`
+                HTMLURL     string `json:"html_url"`
+                Description string `json:"description"`
+                Owner       struct {
+                    AvatarURL string `json:"avatar_url"`
+                } `json:"owner"`
+            } `json:"items"`
+        }
+        if err := json.Unmarshal(body, &payload); err != nil {
+            firstErr = err
+        }
+        for _, it := range payload.Items {
+            snippet := it.Description
+            if len(snippet) > 300 { snippet = snippet[:300] + "..." }
+            results = append(results, en.Result{
+                Title:   it.FullName,
+                URL:     it.HTMLURL,
+                Snippet: snippet,
+                Engine:  g.Name(),
+                Favicon: it.Owner.AvatarURL,
+            })
+            if len(results) >= size { break }
+        }
+    }
+
+    // Issues and pull requests
+    issuesURL := "https://api.github.com/search/issues?q=" + url.QueryEscape(q) +
+        "&per_page=" + strconv.Itoa(size)
+    if body, status, err := httpx.GetWithHeaders(ctx, issuesURL, headers); err != nil {
+        if firstErr == nil { firstErr = err }
+    } else if status < 200 || status >= 300 {
+        if firstErr == nil { firstErr = fmt.Errorf("github: http %d", status) }
+    } else {
+        var payload struct {
+            Items []struct {
+                Title   string `json:"title"`
+                HTMLURL string `json:"html_url"`
+                Body    string `json:"body"`
+                User    struct {
+                    AvatarURL string `json:"avatar_url"`
+                } `json:"user"`
+            } `json:"items"`
+        }
+        if err := json.Unmarshal(body, &payload); err != nil {
+            if firstErr == nil { firstErr = err }
+        }
+        for _, it := range payload.Items {
+            if len(results) >= size { break }
+            snippet := strings.TrimSpace(it.Body)
+            if len(snippet) > 300 { snippet = snippet[:300] + "..." }
+            results = append(results, en.Result{
+                Title:   it.Title,
+                URL:     it.HTMLURL,
+                Snippet: snippet,
+                Engine:  g.Name(),
+                Favicon: it.User.AvatarURL,
+            })
+        }
+    }
+
+    if len(results) == 0 && firstErr != nil { return nil, firstErr }
+    return results, nil
+}
diff --git a/internal/engines/gitlab.go b/internal/engines/gitlab.go
new file mode 100644
index 0000000..2e670b7
--- /dev/null
+++ b/internal/engines/gitlab.go
@@ -0,0 +1,59 @@
+package engines
+
+import (
+    "context"
+    "encoding/json"
+    "fmt"
+    "net/url"
+    "strconv"
+    "strings"
+
+    en "searxgo/internal/engine"
+    "searxgo/internal/httpx"
+)
+
+type gitlab struct{}
+
+func NewGitlab() en.SearchEngine { return &gitlab{} }
+
+func (g *gitlab) Name() string { return "gitlab" }
+
+// Search queries gitlab.com's public projects API.
+func (g *gitlab) Search(ctx context.Context, q string, page int, size int) ([]en.Result, error) {
+    if strings.TrimSpace(q) == "" { return nil, nil }
+    if size <= 0 { size = 10 }
+
+    searchURL := "https://gitlab.com/api/v4/projects?search=" + url.QueryEscape(q) +
+        "&per_page=" + strconv.Itoa(size) + "&simple=true"
+
+    headers := map[string]string{
+        "Accept": "application/json",
+    }
+
+    body, status, err := httpx.GetWithHeaders(ctx, searchURL, headers)
+    if err != nil { return nil, err }
+    if status < 200 || status >= 300 { return nil, fmt.Errorf("gitlab: http %d", status) }
+
+    var items []struct {
+        PathWithNamespace string `json:"path_with_namespace"`
+        WebURL            string `json:"web_url"`
+        Description       string `json:"description"`
+        AvatarURL         string `json:"avatar_url"`
+    }
+    if err := json.Unmarshal(body, &items); err != nil { return nil, err }
+
+    results := make([]en.Result, 0, size)
+    for _, p := range items {
+        snippet := strings.TrimSpace(p.Description)
+        if len(snippet) > 300 { snippet = snippet[:300] + "..." }
+        results = append(results, en.Result{
+            Title:   p.PathWithNamespace,
+            URL:     p.WebURL,
+            Snippet: snippet,
+            Engine:  g.Name(),
+            Favicon: p.AvatarURL,
+        })
+        if len(results) >= size { break }
+    }
+    return results, nil
+}
diff --git a/internal/engines/sourcegraph.go b/internal/engines/sourcegraph.go
new file mode 100644
index 0000000..de6217b
--- /dev/null
+++ b/internal/engines/sourcegraph.go
@@ -0,0 +1,83 @@
+package engines
+
+import (
+    "bufio"
+    "bytes"
+    "context"
+    "encoding/json"
+    "fmt"
+    "net/url"
+    "strconv"
+    "strings"
+
+    en "searxgo/internal/engine"
+    "searxgo/internal/httpx"
+)
+
+type sourcegraph struct{}
+
+func NewSourcegraph() en.SearchEngine { return &sourcegraph{} }
+
+func (s *sourcegraph) Name() string { return "sourcegraph" }
+
+// Search queries Sourcegraph's public streaming search API (SSE).
+// Each "matches" event carries a JSON array of content/path matches.
+// The query is restricted to public contexts; no authentication.
+func (s *sourcegraph) Search(ctx context.Context, q string, page int, size int) ([]en.Result, error) {
+    if strings.TrimSpace(q) == "" { return nil, nil }
+    if size <= 0 { size = 10 }
+    // Broad queries make the stream run until count matches; cap it so the
+    // search finishes inside the aggregator time budget.
+    if size > 10 { size = 10 }
+
+    query := "context:global " + q + " count:" + strconv.Itoa(size)
+    searchURL := "https://sourcegraph.com/.api/search/stream?q=" + url.QueryEscape(query) + "&v=V3"
+
+    headers := map[string]string{
+        "Accept":     "text/event-stream",
+        "User-Agent": "SearxGO/1.0",
+    }
+
+    body, status, err := httpx.GetWithHeaders(ctx, searchURL, headers)
+    if err != nil { return nil, err }
+    if status < 200 || status >= 300 { return nil, fmt.Errorf("sourcegraph: http %d", status) }
+
+    results := make([]en.Result, 0, size)
+    event := ""
+    scanner := bufio.NewScanner(bytes.NewReader(body))
+    scanner.Buffer(make([]byte, 0, 64*1024), 1024*1024)
+    for scanner.Scan() {
+        line := scanner.Text()
+        switch {
+        case strings.HasPrefix(line, "event: "):
+            event = strings.TrimPrefix(line, "event: ")
+        case strings.HasPrefix(line, "data: ") && event == "matches":
+            var matches []struct {
+                Type        string `json:"type"`
+                Repository  string `json:"repository"`
+                Path        string `json:"path"`
+                LineMatches []struct {
+                    Preview string `json:"preview"`
+                } `json:"lineMatches"`
+            }
+            if err := json.Unmarshal([]byte(strings.TrimPrefix(line, "data: ")), &matches); err != nil {
+                continue
+            }
+            for _, m := range matches {
+                if m.Repository == "" || m.Path == "" { continue }
+                snippet := ""
+                if len(m.LineMatches) > 0 { snippet = strings.TrimSpace(m.LineMatches[0].Preview) }
+                if len(snippet) > 300 { snippet = snippet[:300] + "..." }
+                results = append(results, en.Result{
+                    Title:   m.Repository + "/" + m.Path,
+                    URL:     "https://sourcegraph.com/" + m.Repository + "/-/blob/" + m.Path,
+                    Snippet: snippet,
+                    Engine:  s.Name(),
+                })
+                if len(results) >= size { return results, nil }
+            }
+        }
+    }
+    if err := scanner.Err(); err != nil { return nil, err }
+    return results, nil
+}
