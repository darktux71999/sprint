#!/bin/sh -e

export DESTDIR="$1"

# Use clang/lld (sprint toolchain)
export CC=clang
export CXX=clang++
export AR=llvm-ar
export NM=llvm-nm
export RANLIB=llvm-ranlib
export LDFLAGS="$LDFLAGS -fuse-ld=lld"

# Reduce debug symbol size (~50% smaller)
export CFLAGS="$CFLAGS -g1"
export CXXFLAGS="$CXXFLAGS -g1"

# Disable fortify (broken with webkit)
export CFLAGS="$CFLAGS -U_FORTIFY_SOURCE"
export CXXFLAGS="$CXXFLAGS -U_FORTIFY_SOURCE"

# Apply patches
for patch in *.patch; do
    patch -p1 < "$patch"
done

# Detect optional dependencies via pkg-config
pkg-config --exists enchant2       || spellcheck=false
pkg-config --exists gstreamer-1.0  || video=false
pkg-config --exists geoclue-2.0    || geolocation=false
pkg-config --exists libmanette-0.2 || gamepad=false
pkg-config --exists flite          || speech=false
pkg-config --exists libsecret-1    || secret=false
pkg-config --exists libavif        || avif=false
pkg-config --exists libjxl         || jpegxl=false
pkg-config --exists lcms2          || lcms=false
pkg-config --exists libwoff2dec    || woff2=false
pkg-config --exists hyphen         || hyphen=false
pkg-config --exists bubblewrap     || sandbox=false
pkg-config --exists gst-webrtc-1.0 || webrtc=false
pkg-config --exists glesv2         || webgl=false

cmake -B build -G Ninja \
    -DPORT=GTK \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DENABLE_BUBBLEWRAP_SANDBOX="${sandbox:-ON}" \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_GAMEPAD="${gamepad:-ON}" \
    -DENABLE_GEOLOCATION="${geolocation:-ON}" \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_MINIBROWSER=OFF \
    -DENABLE_SAMPLING_PROFILER=OFF \
    -DENABLE_SPELLCHECK="${spellcheck:-ON}" \
    -DENABLE_SPEECH_SYNTHESIS="${speech:-ON}" \
    -DENABLE_VIDEO="${video:-ON}" \
    -DENABLE_WEB_AUDIO="${video:-ON}" \
    -DENABLE_MEDIA_SOURCE="${video:-ON}" \
    -DENABLE_MEDIA_STREAM="${video:-ON}" \
    -DENABLE_MEDIA_RECORDER="${video:-ON}" \
    -DENABLE_ENCRYPTED_MEDIA="${video:-ON}" \
    -DENABLE_WEB_RTC="${webrtc:-ON}" \
    -DENABLE_WEB_CODECS="${video:-ON}" \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_WEBGL="${webgl:-ON}" \
    -DENABLE_WEBGPU=OFF \
    -DENABLE_WEBXR=OFF \
    -DUSE_AVIF="${avif:-ON}" \
    -DUSE_GTK4=OFF \
    -DUSE_JPEGXL="${jpegxl:-ON}" \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN="${hyphen:-ON}" \
    -DUSE_LIBSECRET="${secret:-ON}" \
    -DUSE_LCMS="${lcms:-ON}" \
    -DUSE_SYSPROF_CAPTURE=NO \
    -DUSE_WOFF2="${woff2:-ON}" \
    -DLTO_MODE=thin

cmake --build build -j12
DESTDIR="$1" cmake --install build
