#!/bin/sh -e

export DESTDIR="$1"

# Use clang/lld (sprint toolchain)
export CC=clang
export CXX=clang++
export AR=llvm-ar
export NM=llvm-nm
export RANLIB=llvm-ranlib
export LDFLAGS="$LDFLAGS -fuse-ld=lld"

# Reduce debug symbol size (~50% smaller)
export CFLAGS="$CFLAGS -g1"
export CXXFLAGS="$CXXFLAGS -g1"

# Disable fortify (broken with webkit)
export CFLAGS="$CFLAGS -U_FORTIFY_SOURCE"
export CXXFLAGS="$CXXFLAGS -U_FORTIFY_SOURCE"

cmake -B build -G Ninja \
    -DPORT=GTK \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DENABLE_BUBBLEWRAP_SANDBOX=OFF \
    -DENABLE_CONTEXT_MENUS=OFF \
    -DENABLE_DOCUMENTATION=OFF \
    -DENABLE_DRAG_SUPPORT=OFF \
    -DENABLE_ENCRYPTED_MEDIA=OFF \
    -DENABLE_FULLSCREEN_API=OFF \
    -DENABLE_GAMEPAD=OFF \
    -DENABLE_GEOLOCATION=OFF \
    -DENABLE_INTROSPECTION=OFF \
    -DENABLE_JOURNALD_LOG=OFF \
    -DENABLE_MEDIA_RECORDER=OFF \
    -DENABLE_MEDIA_SOURCE=OFF \
    -DENABLE_MEDIA_STREAM=OFF \
    -DENABLE_MINIBROWSER=OFF \
    -DENABLE_NOTIFICATIONS=OFF \
    -DENABLE_POINTER_LOCK=OFF \
    -DENABLE_SAMPLING_PROFILER=OFF \
    -DENABLE_SPELLCHECK=OFF \
    -DENABLE_SPEECH_SYNTHESIS=OFF \
    -DENABLE_TOUCH_EVENTS=OFF \
    -DENABLE_VIDEO=OFF \
    -DENABLE_WEB_AUDIO=OFF \
    -DENABLE_WEB_CODECS=OFF \
    -DENABLE_WEB_RTC=OFF \
    -DENABLE_WEBDRIVER=OFF \
    -DENABLE_WEBGL=OFF \
    -DENABLE_WEBGPU=OFF \
    -DENABLE_WEBXR=OFF \
    -DUSE_AVIF=OFF \
    -DUSE_GTK4=OFF \
    -DUSE_JPEGXL=OFF \
    -DUSE_LIBBACKTRACE=OFF \
    -DUSE_LIBHYPHEN=OFF \
    -DUSE_LIBSECRET=OFF \
    -DUSE_LCMS=OFF \
    -DUSE_SYSPROF_CAPTURE=NO \
    -DUSE_WOFF2=OFF \
    -DLTO_MODE=thin

cmake --build build
