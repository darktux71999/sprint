#!/bin/sh -e

meson setup build \
	--prefix=/usr \
	--libexecdir=/usr/lib \
	-Dbuildtype=release \
	-Ddbus-srv-user=_geoclue \
	-D3g-source=false \
	-Dcdma-source=false \
	-Dgtk-doc=false \
	-Dintrospection=true \
	-Dmodem-gps-source=false \
	-Dvapi=true
ninja -C build
DESTDIR="$1" ninja -C build install
rm -rf "$1/usr/share/doc"
