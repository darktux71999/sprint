#!/bin/sh -e

mkdir -p "$1/usr/share/fonts/nerd-fonts"

# KISS doesn't extract .zip natively, do it manually
unzip -o NerdFontsSymbolsOnly.zip -d _extract
cp _extract/*.ttf "$1/usr/share/fonts/nerd-fonts/" 2>/dev/null || true
cp _extract/*.otf "$1/usr/share/fonts/nerd-fonts/" 2>/dev/null || true
rm -rf _extract

fc-cache -f "$1/usr/share/fonts"
