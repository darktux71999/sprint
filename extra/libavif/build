#!/bin/sh -e

export DESTDIR="$1"

cmake -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DAVIF_BUILD_APPS=OFF \
    -DAVIF_BUILD_TESTS=OFF \
    -DAVIF_CODEC_DAV1D=SYSTEM \
    -DAVIF_CODEC_AOM=SYSTEM \
    -DAVIF_LIBYUV=OFF

ninja -C build
ninja -C build install
