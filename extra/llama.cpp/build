#!/bin/sh -e

export DESTDIR="$1"

cmake -B build -G Ninja -Wno-dev \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGGML_NATIVE=OFF \
    -DGGML_LTO=ON \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_OPENMP=OFF \
    -DGGML_BLAS=OFF \
    -DGGML_CUDA=OFF \
    -DGGML_VULKAN=OFF \
    -DGGML_RPC=OFF \
    -DLLAMA_BUILD_NUMBER=9672 \
    -DLLAMA_USE_PREBUILT_UI=OFF

cmake --build build
cmake --install build

# Remove tests
find "$1/usr/bin/" -name 'test-*' -exec rm {} \; 2>/dev/null || true
