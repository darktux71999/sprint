#!/bin/sh -e

meson setup build \
	--prefix=/usr \
	--libexecdir=/usr/lib \
	-Dbuildtype=release \
	-Dexamples=false \
	-Dgtk=false \
	-Dhelp=false \
	-Dlibsysprof=false \
	-Dsysprofd=none \
	-Dtests=false \
	-Dtools=false
ninja -C build
DESTDIR="$1" ninja -C build install
install -Dm644 src/libsysprof-capture/COPYING "$1/usr/share/licenses/sysprof-capture/COPYING"
