#!/bin/sh -e

# Keep personal Python packages out of Mach's build environment.
export PYTHONNOUSERSITE=1
export HOME="$PWD/state/home"
mkdir -p "$HOME"

for p in *.patch; do
    patch -p1 < "$p"
done

sed '/UNZIP/d' toolkit/moz.configure > _
mv -f _ toolkit/moz.configure

sed 's/\("files":{\)[^}]*/\1/' third_party/rust/encoding_rs/.cargo-checksum.json > _
mv -f _ third_party/rust/encoding_rs/.cargo-checksum.json
sed 's/\("files":{\)[^}]*/\1/' third_party/rust/audio_thread_priority/.cargo-checksum.json > _
mv -f _ third_party/rust/audio_thread_priority/.cargo-checksum.json

# If using libc++, CXXSTDLIB needs to be set manually.
case $("$CC" -print-file-name=libc++.so) in */*)
    export CXXSTDLIB=c++
esac

export CFLAGS="$CFLAGS -w"
export CXXFLAGS="$CXXFLAGS -w"

# Instruct the compiler to trim absolute paths in resulting binaries and instead
# change them to relative paths ($PWD/... ./...).
export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$PWD=."

# Flags de Rust del motor. Sin -C target-cpu (viene del entorno:
# -C target-cpu=x86-64-v3) el motor se compila para la baseline generica
# x86-64 y se pierde el AVX2 de la CPU. FIREFOX_RUST_EXTRA_FLAGS permite
# anadir mas (por ejemplo -Ccodegen-units=1, que mejora el codegen a costa de
# tiempo y RAM de compilacion).
[ -n "${FIREFOX_RUST_EXTRA_FLAGS:-}" ] &&
    export RUSTFLAGS="$RUSTFLAGS $FIREFOX_RUST_EXTRA_FLAGS"

export LDFLAGS="$LDFLAGS -Wl,-rpath=/usr/lib/firefox,--enable-new-dtags"
export RUSTFLAGS="$RUSTFLAGS -Cdebuginfo=0"
export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=system
export MOZ_DEBUG_FLAGS=-g0
export MOZBUILD_STATE_PATH="$PWD/state"
export MOZ_NOSPAM=1

# .mozconfig: la base de siempre, mas las opciones de PGO de la pasada que
# toque (Mozilla trae soporte nativo: --enable-profile-generate y
# --enable-profile-use; en modo "cross" el perfil alcanza tambien al motor
# de Rust).
write_mozconfig() {
    cat > .mozconfig << EOF
ac_add_options --prefix=/usr
ac_add_options --libdir=/usr/lib
ac_add_options --enable-strip
ac_add_options --enable-release
ac_add_options --enable-rust-simd
ac_add_options --enable-audio-backends=alsa
ac_add_options --enable-install-strip
ac_add_options --enable-official-branding
ac_add_options --enable-application=browser
# Build the GTK frontend with X11 only; do not autodetect or enable Wayland.
ac_add_options --enable-default-toolkit=cairo-gtk3-x11-only
ac_add_options --enable-optimize
# LTO: thin por defecto. Con "cross" el motor de Rust entra tambien en el
# LTO (MOZ_LTO_RUST_CROSS), que es lo que hace que el motor quede optimizado
# de verdad. FIREFOX_LTO lo sobreescribe (p.ej. "thin,cross").
ac_add_options --enable-lto=${FIREFOX_LTO:-thin}
ac_add_options --with-system-ffi
ac_add_options --with-system-jpeg
ac_add_options --with-system-libvpx
ac_add_options --enable-linker=lld
ac_add_options --with-system-nspr
ac_add_options --with-system-nss
ac_add_options --with-system-pixman
ac_add_options --with-system-png
ac_add_options --with-system-webp
ac_add_options --with-system-zlib
ac_add_options --without-wasm-sandboxed-libraries
ac_add_options --disable-eme
ac_add_options --disable-dbus
ac_add_options --disable-tests
ac_add_options --disable-vtune
ac_add_options --disable-updater
ac_add_options --disable-jemalloc
ac_add_options --disable-elf-hack
ac_add_options --disable-callgrind
ac_add_options --disable-profiling
ac_add_options --disable-necko-wifi
ac_add_options --disable-crashreporter
ac_add_options --disable-accessibility
ac_add_options --disable-debug
ac_add_options --disable-debug-symbols
ac_add_options --disable-parental-controls
ac_add_options --disable-system-extension-dirs
EOF
    case ${1:-base} in
        generate)
            cat >> .mozconfig << EOF
ac_add_options --enable-profile-generate=cross
EOF
            ;;
        use)
            cat >> .mozconfig << EOF
ac_add_options --enable-profile-use=cross
ac_add_options --with-pgo-profile-path=$PROF_DATA
EOF
            ;;
    esac
}

if [ "${FIREFOX_PGO:-0}" = 1 ]; then
    # 1) Pasada instrumentada. Mozilla construye el binario instrumentado en
    #    obj-*/instrumented/ y deja ahi el perfil.
    echo "-> PGO: pasada instrumentada"
    write_mozconfig generate
    ./mach build "${MAKEFLAGS:-}"

    # 2) Entrenamiento: el binario instrumentado deja el perfil al ejecutarse.
    PROFILE_HTML="$PWD/pgo-workload.html"
    printf '<html><body><h1>pgo</h1><script>for (let i=0;i<2e5;i++);</script></body></html>\n' \
        > "$PROFILE_HTML"
    INSTR_FIREFOX=$(find . -maxdepth 5 -path '*instrumented*/dist/bin/firefox' -type f 2>/dev/null | head -1)
    if [ -n "$INSTR_FIREFOX" ]; then
        echo "-> PGO: entrenamiento con $INSTR_FIREFOX"
        MOZ_HEADLESS=1 "$INSTR_FIREFOX" --headless \
            --screenshot "$PWD/pgo-shot.png" "file://$PROFILE_HTML" >/dev/null 2>&1 || true
    else
        echo "AVISO: no se encuentra el firefox instrumentado; sin PGO" >&2
    fi

    # 3) Fusionar: llvm-profdata convierte los .profraw en el merged.profdata
    #    que espera --with-pgo-profile-path.
    PROF_RAW=$(find . -maxdepth 5 -name '*.profraw' -path '*instrumented*' 2>/dev/null | head -1)
    PROF_DATA=
    if [ -n "$PROF_RAW" ]; then
        PROF_DIR=$(dirname "$PROF_RAW")
        PROF_DATA="$PROF_DIR/merged.profdata"
        llvm-profdata merge -output="$PROF_DATA" "$PROF_DIR"/*.profraw
    fi

    if [ -n "$PROF_DATA" ] && [ -f "$PROF_DATA" ]; then
        # 4) Pasada final: se recompila usando el perfil.
        echo "-> PGO: pasada final con el perfil"
        write_mozconfig use
        ./mach build "${MAKEFLAGS:-}"
    else
        echo "AVISO: no se ha generado perfil; se instala el build sin PGO" >&2
    fi
else
    write_mozconfig base
    ./mach build "${MAKEFLAGS:-}"
fi

DESTDIR="$1" ./mach install

# Remove a lot of uneeded "stuff".
rm -rf \
    "$1/usr/include" \
    "$1/usr/lib/firefox-devel" \
    "$1/usr/share/idl"
