#!/bin/sh -e

cd netsurf-all-*

# Fix busybox install compatibility (-C and -T flags)
patch -p1 < ../non-coreutils-install-compatibility.patch

# GTK3 frontend only, minimal build
make TARGET=gtk3 PREFIX=/usr

mkdir -p "$1/usr/bin" "$1/usr/share/netsurf"

cp nsgtk "$1/usr/bin/netsurf"
cp -r frontends/gtk/res "$1/usr/share/netsurf/"
