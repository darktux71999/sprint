#!/bin/sh -e

# Fix busybox install -C flag
sed -i 's/INSTALL ?= install -C/INSTALL ?= install/' buildsystem/makefiles/Makefile.tools
patch -p1 < non-coreutils-install-compatibility.patch || true

# gdk-pixbuf lacks XPM loader, remove icon from gresource XML
sed -i '/netsurf\.xpm/d' netsurf/frontends/gtk/res/netsurf.gresource.xml 2>/dev/null || true
sed -i '/netsurf\.xpm/d' netsurf/frontends/gtk/res/ui.gresource.xml 2>/dev/null || true

make TARGET=gtk3 PREFIX=/usr

mkdir -p "$1/usr/bin" "$1/usr/share/netsurf"
cp nsgtk3 "$1/usr/bin/netsurf"
cp -r frontends/gtk/res "$1/usr/share/netsurf/"
