#!/bin/sh -e

# Netsurf uses GNU install -C which busybox doesn't support.
# Force sed on the Makefile.tools before build.

sed -i 's/INSTALL ?= install -C/INSTALL ?= install/' buildsystem/makefiles/Makefile.tools
patch -p1 < non-coreutils-install-compatibility.patch || true

make TARGET=gtk3 PREFIX=/usr

mkdir -p "$1/usr/bin" "$1/usr/share/netsurf"

cp nsgtk "$1/usr/bin/netsurf"
cp -r frontends/gtk/res "$1/usr/share/netsurf/"
