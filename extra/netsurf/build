#!/bin/sh -e

# Fix busybox install -C flag in source and installed copy
sed -i 's/INSTALL ?= install -C/INSTALL ?= install/' buildsystem/makefiles/Makefile.tools
patch -p1 < non-coreutils-install-compatibility.patch || true

# gdk-pixbuf lacks XPM loader, remove icon from gresource
sed -i '/netsurf\.xpm/d' netsurf/frontends/gtk/res/netsurf.gresource.xml 2>/dev/null || true

make TARGET=gtk3 PREFIX=/usr

# Fix the installed Makefile.tools (used by install target)
sed -i 's/INSTALL ?= install -C/INSTALL ?= install/' inst-gtk3/share/netsurf-buildsystem/makefiles/Makefile.tools 2>/dev/null || true

# Override INSTALL for all sub-makes
make TARGET=gtk3 PREFIX=/usr DESTDIR="$1" INSTALL=install install
