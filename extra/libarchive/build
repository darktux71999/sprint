#!/bin/sh -e

./configure \
    --prefix=/usr \
    --disable-acl \
    --disable-xattr \
    --without-expat \
    --without-xml2 \
    --without-nettle \
    --with-lz4 \
    --with-openssl \
    --with-zstd \
    --with-zlib \
    --with-bz2lib \
    --disable-rpath

make
make DESTDIR="$1" install
