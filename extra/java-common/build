#!/bin/sh -e

# Triggers update of JAVA_HOME when JVM is installed/removed
# Adapted from Chimera Linux

mkdir -p "$1/etc/profile.d"

cat > "$1/etc/profile.d/java-jre.sh" << 'PROFILE'
# JAVA_HOME is set by java-common trigger
# This is a placeholder; the actual value is set when a JRE is installed
PROFILE

# The trigger script is run by KISS hooks
# Install it to be run manually or via hooks
mkdir -p "$1/usr/share/java-common"

cat > "$1/usr/share/java-common/update-java-home" << 'TRIGGER'
#!/bin/sh

PROFILE="/etc/profile.d/java-jre.sh"
mkdir -p /etc/profile.d

JAVA_BIN=$(readlink -f /usr/bin/java 2>/dev/null || :)
[ -x "$JAVA_BIN" ] && [ "$JAVA_BIN" != "/usr/bin/java" ] || exit 0

JAVA_HOME="${JAVA_BIN%/bin/java}"
[ -d "$JAVA_HOME" ] || exit 0

cat > "$PROFILE" << EOF
export JAVA_HOME="$JAVA_HOME"
EOF
TRIGGER

chmod 755 "$1/usr/share/java-common/update-java-home"
