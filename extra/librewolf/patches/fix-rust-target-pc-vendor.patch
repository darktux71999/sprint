Add 'pc' to vendor aliases so rust target detection works with musl-llvm
where clang uses x86_64-pc-linux-musl but rust uses x86_64-unknown-linux-musl.

The librewolf source already has a gentoo vendor alias; this simply adds
"pc" to the same tuple.

--- a/build/moz.configure/rust.configure
+++ b/build/moz.configure/rust.configure
@@ -413,15 +413,15 @@ def detect_rustc_target(
         narrowed = [c for c in candidates if c.target.vendor == host_or_target.vendor]
         if len(narrowed) == 1:
             return narrowed[0].rust_target
 
         # Finally, check for vendor gentoo in the target triple.
-        vendor_aliases = {"unknown": ("gentoo")}
+        vendor_aliases = {"unknown": ("gentoo", "pc")}
         narrowed = [
             c
             for c in candidates
             if host_or_target.vendor in vendor_aliases.get(c.target.vendor, ())
         ]
         if len(narrowed) == 1:
             return narrowed[0].rust_target
 
         return None
