#!/bin/sh -e

export DESTDIR="$1"

# Set the CARGO_HOME to current directory to keep build contained
export CARGO_HOME="$PWD"

# Remap paths for reproducibility
export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$PWD=."

# Extract vendor crates and generate checksum files
(
    cd vendor

    for crate in *.crate; do
        tar xf "$crate"

        sha256=$(sha256sum "$crate")
        sha256=${sha256%% *}

        printf '{"package":"%s","files":{}}\n' "$sha256" \
            > "${crate%.crate}/.cargo-checksum.json"
    done
)

# The GitHub tarball extracts to ripgrep-15.1.0/ at the build root.
cd ripgrep-15.1.0

# Remove tikv-jemallocator: musl already uses mimalloc as system allocator.
# 1. Remove from Cargo.toml and Cargo.lock
sed -i '/tikv-jemallocator/d' Cargo.toml Cargo.lock
sed -i '/name = "tikv-jemalloc-sys"/,/^$/d' Cargo.lock
sed -i '/name = "tikv-jemallocator"/,/^$/d' Cargo.lock

# 2. Remove #[global_allocator] from main.rs
sed -i '/#\[cfg(all(target_env = "musl", target_pointer_width = "64"))\]/d' crates/core/main.rs
sed -i '/#\[global_allocator\]/d' crates/core/main.rs
sed -i '/static ALLOC: tikv_jemallocator/d' crates/core/main.rs

# Configure cargo to use vendored sources
mkdir -p .cargo

cat <<EOF > .cargo/config.toml
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "../vendor"
EOF

cargo build --release --frozen --features 'pcre2'

install -Dm755 target/release/rg "$DESTDIR/usr/bin/rg"
