#!/bin/sh -e

export CARGO_HOME="$PWD"
export RUSTFLAGS="$RUSTFLAGS --remap-path-prefix=$PWD=."

(
    cd vendor
    for crate in *.crate; do
        tar xf "$crate"
        sha256=$(sha256sum "$crate")
        sha256=${sha256%% *}
        printf '{"package":"%s","files":{}}\n' "$sha256" \
            > "${crate%.crate}/.cargo-checksum.json"
    done
)

mkdir -p .cargo
cat > .cargo/config.toml <<EOF
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"
EOF

cargo build --release --frozen -j8 \
    -p scx_lavd -p scx_rusty -p scx_bpfland

for b in scx_lavd scx_rusty scx_bpfland; do
    install -Dm755 "target/release/$b" "$1/usr/bin/$b"
done

install -Dm644 LICENSE "$1/usr/share/licenses/scx/LICENSE"

for s in scx-lavd scx-rusty; do
    install -Dm755 "$s.run" "$1/etc/sv/$s/run"
    ln -sf "/run/runit/supervise.$s" "$1/etc/sv/$s/supervise"
done
