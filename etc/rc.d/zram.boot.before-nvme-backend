#!/bin/sh
# ZRAM setup: 4G lz4 (pri=100) + 4G zstd (pri=99)
# Con optimizaciones: mem_limit + writeback a NVMe

# zram0 - lz4, high priority
if [ -e /sys/block/zram0 ]; then
    echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    echo 4G  > /sys/block/zram0/disksize       2>/dev/null || true
    echo 3G  > /sys/block/zram0/mem_limit      2>/dev/null || true
    echo /dev/nvme0n1p2 > /sys/block/zram0/backing_dev 2>/dev/null || true
    grep -q zram0 /proc/swaps || {
        mkswap /dev/zram0
        swapon -p 100 /dev/zram0
    }
fi

# zram1 - zstd, lower priority
zramctl -f -s 4G -a zstd 2>/dev/null

if [ -e /sys/block/zram1 ]; then
    echo 3G > /sys/block/zram1/mem_limit 2>/dev/null || true
    echo /dev/nvme0n1p2 > /sys/block/zram1/backing_dev 2>/dev/null || true
    grep -q zram1 /proc/swaps || {
        mkswap /dev/zram1
        swapon -p 99 /dev/zram1
    }
fi
