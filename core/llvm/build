#!/bin/sh -e

# En KISS, si los parches están en 'sources', se copian al directorio actual.
# Se asume que estás en la raíz donde se descomprimió o donde están los parches.

export DESTDIR="$1"

for patch in *.patch; do
    patch -p1 < "$patch"
done

# Raíz del código fuente: el directorio actual al empezar. Se usa para
# localizar el corpus de entrenamiento sin depender del directorio actual.
SRC_ROOT="$PWD"

# 2. Preparar entorno
# Krak3n usa el monorepo (llvm-project), así que entramos en la carpeta llvm.
# Nota: Ajusta el nombre del directorio si el tarball lo extrae diferente.

# Definimos el Triple para asegurar que LLVM sepa que es nativo musl
HOST_TRIPLE="x86_64-pc-linux-musl"

# 2.1 Jobs de compilacion.
# Modelo de la clase `heavy` de tools/build-class.sh (esa herramienta es la
# definicion canonica; aqui se replican sus numeros porque una receta no
# puede llamarla: durante el build el directorio actual es el de compilacion).
#   heavy: 768 MiB por trabajo (medido: 230-384 MB de pico real con -O2),
#   tope 4, para que el enlace del binario grande (~3 GB) quepa a la vez.
# LLVM_JOBS lo sobrescribe, pero se valida y se acota igual.
HEAVY_RESERVE_KB=786432     # 768 MiB de reserva para el sistema
HEAVY_JOB_KB=786432         # 768 MiB por trabajo de compilacion
HEAVY_MAX_JOBS=4

if [ -n "${LLVM_JOBS:-}" ]; then
    jobs=$LLVM_JOBS
    case $jobs in
        ''|*[!0-9]*)
            echo "AVISO: LLVM_JOBS no es un numero; se ignora" >&2
            jobs=
            ;;
    esac
fi
if [ -z "${jobs:-}" ]; then
    mem_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    jobs=$(( (mem_kb - HEAVY_RESERVE_KB) / HEAVY_JOB_KB ))
    [ "$jobs" -ge 1 ] || jobs=1
    [ "$jobs" -le "$HEAVY_MAX_JOBS" ] || jobs=$HEAVY_MAX_JOBS
fi
echo "Jobs de compilacion: $jobs"

# 2.2 Configuracion de cmake (Krak3n, adaptada a KISS).
# "$@" son las opciones extra de esta pasada (PGO).
#
# CMAKE_BUILD_TYPE=Release aporta -O3 -DNDEBUG, que es lo que usa upstream
# para sus releases. Se quita el nivel -O de CFLAGS porque la linea de
# compilacion no debe llevar dos niveles (gana el ultimo) y la fuente unica
# del nivel de optimizacion es el build type. El resto de CFLAGS (pipe,
# march=native, mtune=native) si se pasa: el compilador tiene que generar
# codigo para esta CPU, no para la baseline generica de x86-64.
#
# Las dos pasadas del PGO (instrumentada y final) deben llevar EXACTAMENTE los
# mismos flags: si difieren, el perfil no encaja con el binario, clang avisa
# de que el perfil esta obsoleto y descarta lo que no casa.
base_cflags=$(printf '%s' "$CFLAGS" | sed 's/-O[0-3sgz]//g')
base_cxxflags=$(printf '%s' "$CXXFLAGS" | sed 's/-O[0-3sgz]//g')

# Flags extra de la pasada en curso (PGO); vacios en el build normal.
EXTRA_C_FLAGS=
EXTRA_CXX_FLAGS=
EXTRA_LD_FLAGS=

configure() {
    cmake -S ../llvm \
        -DCMAKE_C_FLAGS="$base_cflags $EXTRA_C_FLAGS" \
        -DCMAKE_CXX_FLAGS="$base_cxxflags $EXTRA_CXX_FLAGS" \
        -DCMAKE_EXE_LINKER_FLAGS="$LDFLAGS $EXTRA_LD_FLAGS" \
        -DCMAKE_SHARED_LINKER_FLAGS="$LDFLAGS $EXTRA_LD_FLAGS" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_BUILD_TYPE=Release \
        -DLLVM_HOST_TRIPLE="$HOST_TRIPLE" \
        -DLLVM_DEFAULT_TARGET_TRIPLE="$HOST_TRIPLE" \
        -DLLVM_TARGETS_TO_BUILD="X86;AMDGPU;BPF" \
        -DLLVM_BUILD_LLVM_DYLIB=ON \
        -DLLVM_LINK_LLVM_DYLIB=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_EH=ON \
        -DLLVM_ENABLE_LLD=ON \
        -DLLVM_INSTALL_BINUTILS_SYMLINKS=ON \
        -DLLVM_ENABLE_PROJECTS="clang;lld;bolt" \
        -DLLVM_ENABLE_RUNTIMES="compiler-rt;libunwind;libcxx;libcxxabi" \
        -DLLVM_INCLUDE_BENCHMARKS=OFF \
        -DLLVM_INCLUDE_EXAMPLES=OFF \
        -DLLVM_INCLUDE_DOCS=OFF \
        -DLLVM_INCLUDE_TESTS=OFF \
        -DLLVM_ENABLE_LIBXML2=OFF \
        -DCLANG_DEFAULT_RTLIB=compiler-rt \
        -DCLANG_DEFAULT_UNWINDLIB=libunwind \
        -DCLANG_DEFAULT_CXX_STDLIB=libc++ \
        -DCLANG_DEFAULT_LINKER=lld \
        -DCLANG_CONFIG_FILE_SYSTEM_DIR=/etc/clang \
        -DLIBCLANG_BUILD_STATIC=ON \
        -DLIBCXX_HAS_MUSL_LIBC=ON \
        -DLIBCXX_USE_COMPILER_RT=ON \
        -DLIBCXX_CXX_ABI=libcxxabi \
        -DLIBCXXABI_USE_LLVM_UNWINDER=ON \
        -DLIBCXXABI_USE_COMPILER_RT=ON \
        -DLIBUNWIND_USE_COMPILER_RT=ON \
        -DCOMPILER_RT_USE_BUILTINS_LIBRARY=ON \
        -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
        -DCOMPILER_RT_BUILD_XRAY=OFF \
        -DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
        -DCOMPILER_RT_BUILD_PROFILE=ON \
        -Wno-dev \
        "$@"
}

# 2.3 Corpus de entrenamiento: ficheros C que se compilan para que el perfil
# cubra el frontend y el optimizador. Se usan fuentes del propio LLVM y, si
# existen, del GOROOT instalado.
training_files() {
    find "$SRC_ROOT/llvm/utils" -name '*.c' 2>/dev/null | head -20
    find /usr/lib/go/src/runtime -name '*.c' 2>/dev/null | head -20
}

# 2.4 Entrenamiento BOLT: el binario instrumentado por BOLT escribe su
# prof.fdata en el directorio actual. No es un perfil PGO, asi que aqui no se
# toca LLVM_PROFILE_FILE.
bolt_train() {
    bin=$1
    n=0
    for f in $(training_files); do
        "$bin" -c -O2 -I"$SRC_ROOT/llvm/include" -I/usr/lib/go/src/runtime \
            -o /dev/null "$f" 2>/dev/null || continue
        n=$((n + 1))
    done
    echo "Ficheros de entrenamiento para BOLT: $n"
}

# NOTA SOBRE SANITIZERS: Krak3n los tiene en ON, pero en un bootstrap inicial
# con musl puro suelen fallar por falta de rpc/xdr.h.
# Los he puesto en OFF para asegurar el éxito del build.

# 3. Build
mkdir -p build
cd build

if [ "${LLVM_PGO:-0}" = 1 ]; then
    # PGO con la interfaz de clang: -fprofile-generate escribe .profraw,
    # llvm-profdata los fusiona en un .profdata y -fprofile-instr-use lo
    # aplica. (Las opciones propias de LLVM, LLVM_ENABLE_PGO y
    # LLVM_PGO_PROFILE_DIR, no existen en esta version: el cmake solo conoce
    # LLVM_BUILD_INSTRUMENTED y LLVM_PROFDATA_FILE, y con lld la variante
    # instrumentada no llega a la linea de enlace.)
    # El perfil vive FUERA del directorio de build: KISS borra el build al
    # empezar una construccion, asi que dentro se perderia. Ademas asi el
    # perfil sobrevive a un fallo y el entrenamiento se puede reutilizar.
    PROFILE_DIR="${LLVM_PGO_DIR:-$HOME/.cache/llvm-pgo}"
    PROF_DATA="$PROFILE_DIR/merged.profdata"
    mkdir -p "$PROFILE_DIR"

    # El PGO necesita el runtime de perfil (libclang_rt.profile.a) en el
    # toolchain que compila: sin el, la pasada instrumentada no enlaza
    # (__llvm_profile_* sin resolver). Ese runtime lo trae un llvm ya
    # construido con COMPILER_RT_BUILD_PROFILE=ON, asi que el PGO va en dos
    # fases: primero un build normal que instale el runtime, despues este.
    if ! ls /usr/lib/clang/*/lib/*/libclang_rt.profile.a >/dev/null 2>&1; then
        echo "AVISO: el toolchain no trae libclang_rt.profile.a" >&2
        echo "       construye primero llvm con COMPILER_RT_BUILD_PROFILE=ON" >&2
        echo "       y despues relanza el build con LLVM_PGO=1" >&2
    fi

    if [ -f "$PROF_DATA" ]; then
        # El perfil ya esta: se reutiliza y NO se limpia el build, para que
        # los objetos ya construidos con el perfil se aprovechen (el build
        # se queda como no-op). Asi se puede relanzar un build que fallo al
        # final (por ejemplo en el paso de BOLT) sin repetir las 4 horas.
        echo "-> PGO: se reutiliza el perfil existente"
        profile_nuevo=0
    else
        profile_nuevo=1

        echo "-> PGO: primera pasada instrumentada"
        EXTRA_C_FLAGS="-fprofile-generate=$PROFILE_DIR"
        EXTRA_CXX_FLAGS="-fprofile-generate=$PROFILE_DIR"
        EXTRA_LD_FLAGS="-fprofile-generate=$PROFILE_DIR"
        configure
        EXTRA_C_FLAGS=
        EXTRA_CXX_FLAGS=
        EXTRA_LD_FLAGS=
        cmake --build . -j "$jobs"

        echo "-> PGO: entrenamiento"
        # El perfil sale de compilar codigo pesado con el clang instrumentado,
        # que es el flujo que usa upstream: se reconstruye la parte caliente del
        # compilador (IR, optimizador y backend X86) con el clang ya instrumentado.
        cd ..
        rm -rf build-train
        mkdir -p build-train
        cd build-train
        configure \
            -DCMAKE_C_COMPILER="$PWD/../build/bin/clang" \
            -DCMAKE_CXX_COMPILER="$PWD/../build/bin/clang++" \
            -DCMAKE_AR="$PWD/../build/bin/llvm-ar" \
            -DCMAKE_RANLIB="$PWD/../build/bin/llvm-ranlib" \
            -DCMAKE_NM="$PWD/../build/bin/llvm-nm"
        # Los targets de cmake: el backend se declara con
        # add_llvm_component_group(X86), asi que el target es "X86" (la
        # biblioteca que produce se llama libLLVMTargetX86.a).
        # Se construyen de uno en uno para que un target que falle no impida
        # entrenar con los demas.
        for target in LLVMCore LLVMCodeGen X86; do
            cmake --build . -j "$jobs" --target "$target" || \
                echo "AVISO: no se pudo construir $target para el entrenamiento" >&2
        done
        cd ../build

        if ls "$PROFILE_DIR"/*.profraw >/dev/null 2>&1; then
            "$PWD/bin/llvm-profdata" merge -output="$PROF_DATA" \
                "$PROFILE_DIR"/*.profraw
        fi
    fi

    if [ -f "$PROF_DATA" ]; then
        echo "-> PGO: segunda pasada con el perfil"
        if [ "$profile_nuevo" = 1 ]; then
            # Solo si el perfil se acaba de generar: si ya existia, los
            # objetos ya estan construidos con el perfil y limpiarlos seria
            # tirar las horas de compilacion.
            cmake --build . --target clean
            rm -rf CMakeCache.txt CMakeFiles
        fi
        EXTRA_C_FLAGS="-fprofile-instr-use=$PROF_DATA"
        EXTRA_CXX_FLAGS="-fprofile-instr-use=$PROF_DATA"
        EXTRA_LD_FLAGS="-fprofile-instr-use=$PROF_DATA"
        configure
        EXTRA_C_FLAGS=
        EXTRA_CXX_FLAGS=
        EXTRA_LD_FLAGS=
        cmake --build . -j "$jobs"
    else
        echo "AVISO: no se ha generado ningun perfil; se instala el build" \
            "instrumentado sin PGO" >&2
    fi
else
    configure
    cmake --build . -j "$jobs"
fi

# 4. BOLT: reordenar el codigo de los binarios con un perfil real.
# Modo instrumentacion: no hace falta perf (que no esta instalado).
if [ "${LLVM_BOLT:-0}" = 1 ]; then
    echo "-> BOLT: instrumentando y reordenando los binarios"
    BOLT="$PWD/bin/llvm-bolt"
    for bin in clang clang++ lld ld.lld; do
        [ -x "$PWD/bin/$bin" ] || continue
        rm -rf bolt-fdata && mkdir -p bolt-fdata
        if ! "$BOLT" "$PWD/bin/$bin" -instrument -o "$PWD/bin/$bin.instr" \
            -j "$jobs"; then
            echo "AVISO: BOLT no pudo instrumentar $bin" >&2
            continue
        fi
        (cd bolt-fdata && bolt_train "$PWD/../bin/$bin.instr")
        if ! ls bolt-fdata/*.fdata >/dev/null 2>&1; then
            echo "AVISO: BOLT no recogio perfil de $bin" >&2
            continue
        fi
        "$BOLT" merge-fdata -o "$PWD/bin/$bin.fdata" bolt-fdata/*.fdata || continue
        if ! "$BOLT" "$PWD/bin/$bin" -data="$PWD/bin/$bin.fdata" \
            -o "$PWD/bin/$bin.bolt" -j "$jobs"; then
            echo "AVISO: BOLT no pudo reordenar $bin" >&2
            continue
        fi
        mv -f "$PWD/bin/$bin.bolt" "$PWD/bin/$bin"
        rm -f "$PWD/bin/$bin.instr" "$PWD/bin/$bin.fdata"
    done
    rm -rf bolt-fdata
fi

# 5. Instalar
cmake --install .

# 6. Post-instalación: Enlaces simbólicos (Reemplazo de GCC/Binutils)
cd "$1/usr/bin"

# Enlaces para que el sistema crea que tiene GCC/Binutils
ln -sf lld ld
ln -sf clang cc
ln -sf clang gcc
ln -sf clang cpp
ln -sf clang++ c++
ln -sf clang++ g++

# Scripts c89/c99 (Opcional, si los tienes en sources instalalos, si no, omite)
