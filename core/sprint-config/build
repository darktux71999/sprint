#!/bin/sh -e

mkdir -p "$1/etc/rc.d" "$1/etc/sysctl.d"

# Boot hooks.
for f in cgroup-delegate.boot cpu-governor.boot damon.boot io-sched.boot keymap.boot network.boot zram.boot; do
    install -Dm755 "$f" "$1/etc/rc.d/$f"
done

install -Dm644 99-sprint-optimize.conf "$1/etc/sysctl.d/99-sprint-optimize.conf"

install -Dm755 disk-optimize.sh "$1/opt/mdev/disk-optimize.sh"
install -Dm755 nvme-optimize.sh "$1/opt/mdev/nvme-optimize.sh"
