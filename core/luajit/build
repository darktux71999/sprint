#!/bin/sh -e

libunwind_path=$("$CC" -print-file-name=libunwind.so)
case $libunwind_path in */*)
    export LDFLAGS="$LDFLAGS -lunwind"
esac

export CFLAGS="$CFLAGS -fPIC"

make amalg PREFIX=/usr CC="$CC" HOST_LUA='luajit -joff'
make install PREFIX=/usr DESTDIR="$1" HOST_LUA='luajit -joff'

# Create these symlinks ourselves as luajit relies
# on ldconfig to do so and musl does not provide it.
for library in "$1"/usr/lib/libluajit-5.1.so.2.*; do
	[ -f "$library" ] && break
done
[ -f "$library" ] || exit 1
library=${library##*/}
ln -sf "$library" "$1/usr/lib/libluajit-5.1.so"
ln -sf "$library" "$1/usr/lib/libluajit-5.1.so.2"
