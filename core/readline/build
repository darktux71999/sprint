#!/bin/sh -e

export DESTDIR="$1"

for patch in readline83-*; do
    [ -f "$patch" ] || continue
    patch -p0 < "$patch"
done

for patch in *.patch; do
    [ -f "$patch" ] || continue
    patch -p0 < "$patch"
done

bash_cv_termcap_lib=libtinfo ./configure \
    --prefix=/usr \
    --mandir=/usr/share/man \
    --infodir=/usr/share/info \
    --disable-static \
    --enable-multibyte \
    --with-curses

make
make DESTDIR="$DESTDIR" install

rm -rf "$DESTDIR/usr/share/doc"
install -Dm644 inputrc "$DESTDIR/etc/inputrc"
