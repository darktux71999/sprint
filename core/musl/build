#!/bin/sh -e


# 1. Preparación de Directorios
# KISS extrae los tarballs. Identificamos las carpetas creadas.
# (El '|| true' evita errores si ya se llaman así o si se re-ejecuta)
# ---------------------------------------------------------
# FASE 1: Compilar Mimalloc (El "Injerto")
# ---------------------------------------------------------
cp -f mimalloc.c mimalloc/src/mimalloc.c
echo ">>> Compilando Mimalloc estático..."

cd mimalloc


# Compilamos un objeto único (.o) que secuestra los símbolos malloc/free
# -DMI_MALLOC_OVERRIDE: Renombra funciones para reemplazar las de libc
# -DMI_BUILD_SHARED: Necesario para vivir dentro de libc.so
clang $CFLAGS -fPIC -O3 \
    -DMI_MALLOC_OVERRIDE \
    -DMI_BUILD_SHARED \
    -I include \
    -c src/static.c \
    -o mimalloc.o

# Verificamos que se creó (para no seguir si falla aquí)
[ -f mimalloc.o ] || { echo "Error: mimalloc.o no se creó"; exit 1; }

cd ..

# ---------------------------------------------------------
# FASE 2: Configurar y Compilar Musl
# ---------------------------------------------------------

# Aplicar los parches estándar de KISS (están en el directorio padre)

for patch in *.patch; do
    patch -p1 < "$patch"
done


# OPTIMIZACIÓN: Eliminar versiones ASM de memcpy/memmove de Musl.
# Clang con AVX genera código más rápido que este ASM genérico manual.
rm -f src/string/x86_64/memcpy.s src/string/x86_64/memmove.s

# Configuración
# --with-malloc=external: Le dice a Musl "no uses tu mallocng"
./configure \
    --prefix=/usr \
    --syslibdir=/usr/lib \
    --disable-gcc-wrapper \
    --with-malloc=external

echo ">>> Inyectando mimalloc.o en config.mak..."
echo "LOBJS += ../mimalloc.o" >> config.mak

# Compilación (Enlazando con el objeto de Mimalloc)
echo ">>> Enlazando Musl con motor Mimalloc..."
make EXTRA_OBJ=../mimalloc.o

# Instalación
make DESTDIR="$1" install

# ---------------------------------------------------------
# FASE 3: Enlaces y Compatibilidad (Estilo KISS)
# ---------------------------------------------------------

# Crear directorio de binarios si no existe
mkdir -p "$1/usr/bin"

# Enlace simbólico para ldd (standard de KISS) [cite: 713]
ln -s /usr/lib/ld-musl-x86_64.so.1 "$1/usr/bin/ldd"

# Arreglar el enlace libc.so -> ld-musl (standard de KISS) [cite: 714]
ln -sf libc.so "$1/usr/lib/ld-musl-x86_64.so.1"

# Instalar Cabeceras BSD (queue.h, tree.h, cdefs.h)
# Están en el directorio base donde KISS las descargó
echo ">>> Instalando cabeceras BSD..."
mkdir -p "$1/usr/include/sys"
cp -f ./cdefs.h ./queue.h ./tree.h "$1/usr/include/sys/"

# ---------------------------------------------------------
# FASE 4: Utilidades Extra y SSP (Chimera Style)
# ---------------------------------------------------------
echo ">>> Compilando utilidades extra..."

# Stack Protector (libssp_nonshared.a) - Vital para Clang Hardened
# Compilamos el .c que descargamos y creamos el archivo .a
clang $CFLAGS -c __stack_chk_fail_local.c -o __stack_chk_fail_local.o
llvm-ar rcs "$1/usr/lib/libssp_nonshared.a" __stack_chk_fail_local.o

# Compilar getconf, getent e iconv
# Usamos 'cc' que apuntará a tu clang del host (o del chroot)
for tool in getconf getent iconv; do
    echo "   Compilando $tool..."
    cc $CFLAGS "$tool.c" -o "$1/usr/bin/$tool"
done

echo ">>> ¡Build de Musl+Mimalloc completado!"
